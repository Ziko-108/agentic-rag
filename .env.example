# Copy to .env and fill in. .env is git-ignored and never baked into an image.

# --- LLM / embeddings
OPENAI_API_KEY=

# --- Postgres (source of truth + pgvector)
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag

# --- Tracing (optional). Free account at https://cloud.langfuse.com -> project -> API keys.
# Leave empty to turn tracing off. For the US region use https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Fallback LLM (optional): Ollama on the host, used when OpenAI fails.
# One-time setup (16k context, so the sources are not cut off):
#   ollama pull qwen2.5:7b
#   curl http://localhost:11434/api/create -d '{"model":"qwen2.5:7b-16k","from":"qwen2.5:7b","parameters":{"num_ctx":16384}}'
# FALLBACK_MODEL=qwen2.5:7b-16k
# OLLAMA_URL=http://host.docker.internal:11434/v1   # the default in docker-compose.yml

# --- Optional overrides (defaults are in backend/app/config.py)
# CHAT_MODEL=gpt-4.1-mini
# DAILY_USD_PER_USER=1.00
